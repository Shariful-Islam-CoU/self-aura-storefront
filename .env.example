# Base URL of the Self Aura backend REST API (see README "Expected backend URL").
# The backend runs on port 5000 by default and mounts routes under /api.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public origin of this storefront — used for SEO metadata (metadataBase).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX).
#
# Product page views, cart events, checkout steps, and purchases are tracked
# via GA4. This is the ONLY analytics credential the browser ever needs: the
# GA4 script is loaded from https://www.googletagmanager.com/gtag/js and the
# measurement ID is passed to gtag('config', ...). No API secret is ever
# exposed to the browser.
#
# The measurement ID is validated against the GA4 format (G-XXXXXXXXXX).
# An invalid or missing value produces a build-time warning and analytics
# silently degrades to a no-op, rather than breaking the storefront.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudinary cloud name, e.g. dzcqtjtiw
#
# Product photos, category thumbnails and video posters are delivered from
# https://res.cloudinary.com/<cloud>/... and this value is the only piece of
# Cloudinary configuration a browser needs: next.config.ts uses it to build a
# narrowly scoped next/image allow-list for exactly those two upload trees.
#
# This is the cloud name ONLY. The API key and API secret stay on the backend
# (self_aura_backend/.env) and must never be placed in this file, in any other
# NEXT_PUBLIC_* variable, or in anything committed to version control. A
# NEXT_PUBLIC_* value is inlined into the client bundle and is readable by
# every visitor.
#
# The name is validated against Cloudinary's shape (lowercase letters, digits
# and dashes). An invalid or missing value produces a build-time warning and no
# Cloudinary pattern at all, rather than a permissive one.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# DEPRECATED for new work — kept only so products uploaded before the
# Cloudinary migration still render. Those records hold root-relative
# /media/<key> paths, which the adapter resolves against the API origin above,
# so the API has to stay allow-listed until every one has been re-uploaded.
# Anything new belongs on Cloudinary, not in this list.
#
# Extra trusted image origins for next/image, comma-separated, e.g.
#   https://media.selfaura.com,https://cdn.internal.example
# The API origin (from NEXT_PUBLIC_API_URL) is always allowed. This is an
# ALLOW-LIST — wildcards are deliberately not supported, because allowing any
# host would let next/image be pointed at an arbitrary third-party URL.
NEXT_PUBLIC_MEDIA_HOSTS=

# Merchant bKash/Nagad receiving numbers are NOT configured here.
# They are managed in the Management App (Payment Settings) and served to the
# storefront at runtime through the backend's public endpoint
# GET /api/public/payment-settings. The storefront never hardcodes them.
